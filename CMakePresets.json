{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "ACCELERATEWORLD_ENABLE_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (RTX 20/30/40/50 portable targets)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "75;86;89;120"
      }
    },
    {
      "name": "rtx20",
      "inherits": "base",
      "displayName": "Release for RTX 20 / Turing (sm_75)",
      "binaryDir": "${sourceDir}/build/rtx20",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "rtx30",
      "inherits": "base",
      "displayName": "Release for RTX 30 / Ampere (sm_86)",
      "binaryDir": "${sourceDir}/build/rtx30",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "rtx40",
      "inherits": "base",
      "displayName": "Release for RTX 40 / Ada (sm_89)",
      "binaryDir": "${sourceDir}/build/rtx40",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "rtx50",
      "inherits": "base",
      "displayName": "Release for RTX 50 / Blackwell (sm_120)",
      "binaryDir": "${sourceDir}/build/rtx50",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "120"
      }
    },
    {
      "name": "rtx5060",
      "inherits": "rtx50",
      "displayName": "RTX 5060 reference profile (sm_120)",
      "binaryDir": "${sourceDir}/build/rtx5060"
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "CI compile validation (all supported RTX generations)",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ACCELERATEWORLD_CUDA_ARCHITECTURES": "75;86;89;120"
      }
    }
  ],
  "buildPresets": [
    {"name": "release-build", "configurePreset": "release", "jobs": 4},
    {"name": "rtx20-build", "configurePreset": "rtx20", "jobs": 4},
    {"name": "rtx30-build", "configurePreset": "rtx30", "jobs": 4},
    {"name": "rtx40-build", "configurePreset": "rtx40", "jobs": 4},
    {"name": "rtx50-build", "configurePreset": "rtx50", "jobs": 4},
    {"name": "rtx5060-build", "configurePreset": "rtx5060", "jobs": 4},
    {"name": "ci-build", "configurePreset": "ci", "jobs": 4}
  ],
  "testPresets": [
    {"name": "release-test", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "rtx20-test", "configurePreset": "rtx20", "output": {"outputOnFailure": true}},
    {"name": "rtx30-test", "configurePreset": "rtx30", "output": {"outputOnFailure": true}},
    {"name": "rtx40-test", "configurePreset": "rtx40", "output": {"outputOnFailure": true}},
    {"name": "rtx50-test", "configurePreset": "rtx50", "output": {"outputOnFailure": true}},
    {"name": "rtx5060-test", "configurePreset": "rtx5060", "output": {"outputOnFailure": true}}
  ]
}
