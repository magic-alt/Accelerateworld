{
  "schema_version": 2,
  "suite": "native-cuda",
  "benchmarks": [
    {
      "id": "vector_add",
      "description": "Bandwidth-limited vector addition",
      "requires": ["cuda"],
      "primary_metric": {"key": "effective_bandwidth", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_vector_add{exe}", "--elements", "33554432", "--iterations", "50"]
    },
    {
      "id": "matmul",
      "description": "Naive vs shared-memory tiled FP32 matrix multiplication",
      "requires": ["cuda"],
      "primary_metric": {"key": "tiled_secondary", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_matmul{exe}", "--size", "1024", "--iterations", "10"]
    },
    {
      "id": "reduction",
      "description": "Atomic vs shared-memory vs warp-shuffle reduction",
      "requires": ["cuda"],
      "primary_metric": {"key": "warp_shuffle_useful_bandwidth", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_reduction{exe}", "--elements", "8388608", "--iterations", "20"]
    },
    {
      "id": "prefix_scan",
      "description": "GPU serial vs shared hierarchical vs warp hierarchical exclusive scan with CUB DeviceScan reference",
      "requires": ["cuda"],
      "primary_metric": {"key": "warp_hierarchical_useful_bandwidth", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_prefix_scan{exe}", "--elements", "4194304", "--iterations", "10"]
    },
    {
      "id": "histogram",
      "description": "Global atomic vs warp aggregation vs shared privatization vs two-pass histogram under uniform/hot/single-bin contention, with CUB reference",
      "requires": ["cuda"],
      "primary_metric": {"key": "hot_two_pass_throughput", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_histogram{exe}", "--elements", "8388608", "--bins", "256", "--iterations", "20", "--hot-percent", "90", "--distribution", "all"]
    },
    {
      "id": "memory_coalescing",
      "description": "Coalesced vs strided global-memory reads",
      "requires": ["cuda"],
      "primary_metric": {"key": "coalesced_secondary", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_memory_coalescing{exe}", "--elements", "1048576", "--stride", "32", "--iterations", "30"]
    },
    {
      "id": "transpose",
      "description": "Naive vs padded shared-memory matrix transpose",
      "requires": ["cuda"],
      "primary_metric": {"key": "shared_memory_tiled_padding_secondary", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_transpose{exe}", "--size", "2048", "--iterations", "30"]
    },
    {
      "id": "streams_pinned",
      "description": "Pageable sequential vs pinned asynchronous multi-stream transfer pipeline",
      "requires": ["cuda"],
      "primary_metric": {"key": "effective_transfer_compute_throughput", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_streams_pinned{exe}", "--elements", "16777216", "--streams", "4", "--iterations", "10"]
    },
    {
      "id": "async_memory_pool",
      "description": "Legacy cudaMalloc/cudaFree vs cudaMallocAsync/cudaFreeAsync pool reuse, release-threshold tuning, mixed sizes and multi-stream sharing",
      "requires": ["cuda", "memory_pool"],
      "primary_metric": {"key": "retained_pool_steady_state_cycle_latency", "direction": "lower"},
      "command": ["{build_dir}/bin/aw_async_memory_pool{exe}", "--bytes", "4194304", "--cycles", "64", "--rounds", "8", "--streams", "4", "--release-threshold-mb", "256"]
    },
    {
      "id": "stream_ordered_allocator",
      "description": "Same-stream and cross-stream cudaMallocAsync reuse-policy matrix with explicit events, opportunistic/internal dependency controls, and default-vs-custom pools",
      "requires": ["cuda", "memory_pool"],
      "primary_metric": {"key": "custom_event_follow_steady_state_cycle_latency", "direction": "lower"},
      "command": ["{build_dir}/bin/aw_stream_ordered_allocator{exe}", "--bytes", "4194304", "--cycles", "32", "--rounds", "6", "--spin-cycles", "5000", "--release-threshold-mb", "256", "--pool-max-mb", "64"]
    },
    {
      "id": "cuda_graph",
      "description": "Direct kernel launches vs CUDA Graph replay",
      "requires": ["cuda", "cuda_graph"],
      "primary_metric": {"key": "cuda_graph_sequence", "direction": "lower"},
      "command": ["{build_dir}/bin/aw_cuda_graph{exe}", "--elements", "65536", "--iterations", "1000"]
    },
    {
      "id": "cublas_gemm",
      "description": "Vendor-library FP32 SGEMM baseline",
      "requires": ["cuda"],
      "primary_metric": {"key": "throughput", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_cublas_gemm{exe}", "--size", "1024", "--iterations", "30"]
    },
    {
      "id": "cublaslt_autotune",
      "description": "Strict-FP32 cuBLASLt heuristic shortlist, measured candidate autotuning, workspace budget and shape-dependent dispatch evidence",
      "requires": ["cuda"],
      "primary_metric": {"key": "best_cublaslt_throughput", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_cublaslt_autotune{exe}", "--m", "1024", "--n", "1024", "--k", "1024", "--heuristics", "16", "--warmup", "2", "--iterations", "10", "--workspace-mb", "32", "--order", "col", "--epilogue", "none", "--no-cache"]
    },
    {
      "id": "tensor_core_wmma",
      "description": "FP16 input / FP32 accumulate Tensor Core GEMM",
      "requires": ["cuda", "tensor_core", "wmma_fp16"],
      "primary_metric": {"key": "throughput", "direction": "higher"},
      "command": ["{build_dir}/bin/aw_tensor_core_wmma{exe}", "--size", "1024", "--iterations", "20"]
    }
  ]
}
